# Optional overrides. Copy this file to .envrc and run direnv allow.
# Without overrides, npm run start:cdp discovers Chrome or Chromium.
# export SHOW_TOOLS_CHROMIUM_APP="/Applications/Chromium.app"
# Or: export SHOW_TOOLS_CHROMIUM_APP="/Applications/Google Chrome.app"
# Inside quotes, spaces need no backslash escaping.
# export SHOW_TOOLS_CDP_PORT="9222"
# export SHOW_TOOLS_CDP_PROFILE="/tmp/show-tools-sheets-cdp"
# export SHOW_TOOLS_PRACTICE_ORIGIN="http://127.0.0.1:8082"
# export SHOW_TOOLS_SET_LIST_URL="https://docs.google.com/spreadsheets/d/1HZ6FipBtjaqPWAisDmjFY-Vvn_UtUfaH2gsNsY41USg/edit"
