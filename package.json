{
  "name": "show-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8082 --bind 127.0.0.1 --directory dist",
    "start:relay": "node --import tsx lib/relay/server.ts",
    "start:sheets": "./show-tools sheets",
    "start:cdp": "bash scripts/start-cdp.sh",
    "build": "npm run build:wasm && npm run build:ui",
    "build:ui": "node --import tsx scripts/build-ui.ts",
    "build:wasm": "bash lib/beat-tracker/scripts/build-manual-wasm.sh",
    "test": "node --import tsx --test lib/voice-catalog/tests/*.test.ts lib/performance/tests/*.test.ts lib/sampler/tests/*.test.mjs lib/sequencer/tests/*.test.mjs ui/practice/tests/*.test.mjs ui/practice/tests/*.test.ts lib/beat-tracker/tests/manual_wasm_tests.mjs scripts/tests/*.test.ts lib/peripherals/tests/*.test.ts hardware/cad/tests/*.test.ts",
    "test:follower": "SHOW_TOOLS_FOLLOWER_TESTS=1 npm test",
    "typecheck": "tsc --noEmit",
    "check:layout": "node --import tsx scripts/check-ui-layout.ts",
    "verify:musicxml": "node --import tsx scripts/verify-musicxml-cutover.ts",
    "verify:dyc": "node --import tsx scripts/verify-dyc-performance.ts",
    "test:peripherals": "node --import tsx lib/peripherals/scripts/verify.ts",
    "test:lights": "node --import tsx scripts/verify-light-bank.ts",
    "peripherals:summary": "node --import tsx lib/peripherals/scripts/summarize.ts",
    "build:video": "node --import tsx scripts/build-video-motion.ts && node --import tsx scripts/build-video.ts",
    "test:video": "node --import tsx --test lib/video/tests/*.test.ts ui/video/tests/*.test.ts",
    "test:figma-exports": "node --import tsx --test scripts/video-expansion/design-system/*.test.mts",
    "test:cad-commands": "node --import tsx --test hardware/cad/tests/candidate-command.test.ts"
  },
  "dependencies": {
    "effect": "4.0.6",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "pixi.js": "8.22.0",
    "sql.js": "1.15.2",
    "wasm-media-encoders": "0.7.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "bin": {
    "show-tools": "./show-tools"
  }
}
