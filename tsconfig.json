{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["ui/practice/**/*.ts", "ui/sheets-musicxml/**/*.ts", "lib/relay/**/*.ts", "lib/remote-performance/**/*.ts", "lib/voice-catalog/**/*.ts", "lib/peripherals/**/*.ts", "lib/performance/**/*.ts", "scripts/**/*.ts", "scripts/video-expansion/design-system/**/*.mts", "ui/video/**/*.ts", "lib/video/**/*.ts", "hardware/cad/**/*.ts"],
  "exclude": ["dist", "node_modules", "lib/peripherals/build"]
}
