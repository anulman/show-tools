#!/usr/bin/env bash
set -euo pipefail
CAD_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${1:-}" == candidate ]]; then
  shift
  exec node --import tsx "$CAD_DIR/candidate-command.ts" "$@"
fi
CAD_ENV="${SHOW_TOOLS_CAD_ENV:-$HOME/.local/share/show-tools/cad/venv}"
if [[ "${1:-}" == setup ]]; then
  CAD_BOOTSTRAP="${SHOW_TOOLS_CAD_BOOTSTRAP_PYTHON:-/opt/homebrew/bin/python3.12}"
  "$CAD_BOOTSTRAP" -m venv "$CAD_ENV"
  "$CAD_ENV/bin/python" -m pip install -r "$CAD_DIR/requirements.lock"
  exit
fi
if [[ ! -x "$CAD_ENV/bin/python" ]]; then
  echo "CAD environment missing. Run: $CAD_DIR/cad setup" >&2
  exit 1
fi
case "${1:-help}" in
  desk)
    shift
    "$CAD_DIR/../../node_modules/.bin/tsc" --project "$CAD_DIR/../../ui/cad"
    "$CAD_DIR/../../node_modules/.bin/esbuild" "$CAD_DIR/../../ui/cad/app.ts" --bundle --format=esm --outfile="$CAD_DIR/build/desk/app.js"
    exec "$CAD_ENV/bin/python" -u "$CAD_DIR/desk_server.py" "$@"
    ;;
  viewer)
    shift
    exec "$CAD_ENV/bin/python" -u -m ocp_viewer --host 127.0.0.1 --port 3939 --control orbit --tree_width 320 --theme light --reset_camera keep "$@"
    ;;
  box-check)
    shift
    exec "$CAD_ENV/bin/python" "$CAD_DIR/box_mount.py" "$@"
    ;;
  disco-check)
    shift
    exec "$CAD_ENV/bin/python" "$CAD_DIR/disco_bar.py" "$@"
    ;;
  view)
    shift
    exec "$CAD_ENV/bin/python" "$CAD_DIR/workspace.py" "$@"
    ;;
  bases)
    shift
    exec "$CAD_ENV/bin/python" "$CAD_DIR/base_concepts.py" "$@"
    ;;
  button)
    shift
    exec "$CAD_ENV/bin/python" "$CAD_DIR/button_reference.py" "$@"
    ;;
  demo)
    shift
    exec "$CAD_ENV/bin/python" "$CAD_DIR/demo_mount.py" --show "$@"
    ;;
  check|export)
    shift
    exec "$CAD_ENV/bin/python" "$CAD_DIR/demo_mount.py" "$@"
    ;;
  *)
    echo "Usage: $0 {candidate|setup|desk|viewer|view|box-check|disco-check|button|bases|demo|check|export} [options]"
    echo "Start viewer in one terminal; demo publishes an assembly; check/export need no viewer."
    ;;
esac
